# Copy this file to ".env" (same folder) before running "docker compose up".
# docker compose reads ".env" automatically - never commit the real ".env".

# A long, random, secret string - identical requirement whether you're
# running locally or deploying. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Password for the postgres superuser INSIDE the Docker container (only
# used by the container itself - unrelated to any password on your host machine).
POSTGRES_SUPERUSER_PASSWORD=postgres

# The frontend origin(s) allowed to call the API Gateway. Add your deployed
# Vercel URL here once you have it (comma-separated for multiple).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: gateway rate limiting.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=10

# Optional: real order/delivery emails (off by default - see docs/DEPLOY.md).
NOTIFICATIONS_EMAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
